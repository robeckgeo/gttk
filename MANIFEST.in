# Core metadata files
include README.md
include README.es.md
include CHANGELOG.md
include LICENSE
include pyproject.toml
include requirements.txt

# Package data: everything under gttk/resources except the caches the build
# scripts fill, and never compiled bytecode
recursive-include gttk/resources *
recursive-exclude gttk/resources/esri/cache *
recursive-exclude gttk/resources/tiff/cache *
global-exclude __pycache__ *.py[cod]

# Not part of the distribution
exclude .gitignore
exclude coverage.xml
exclude .coverage
prune htmlcov
prune input
prune output
prune plans
prune tests
prune temp
